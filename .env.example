# ════════════════════════════════════════════
#          VANTAGE-X MD  —  .env config
#   Edit this file to personalise your bot.
#   Copy to .env and fill in your values.
# ════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────
SESSION_ID=
OWNER_NUMBER=

# ── BOT IDENTITY ──────────────────────────────────────────────────────────────
BOT_NAME=VANTAGE-X MD
OWNER_NAME=Nord-X
PREFIX=!

BOT_MODE=public   #Set to public/private/inbox

# ── SUPPORT LINKS ─────────────────────────────────────────────────────────────
WHATSAPP_GROUP=https://chat.whatsapp.com/PLACEHOLDER
WHATSAPP_CHANNEL=https://whatsapp.com/channel/PLACEHOLDER
TELEGRAM=https://t.me/N0rd_X

# ── BRANDING ──────────────────────────────────────────────────────────────────
THEME_EMOJI=🔒
VANTAGEX_PP=https://res.cloudinary.com/fgeb24n7/image/upload/v1783969654/status_zuf9mc.png
PACKNAME=Sticker By VANTAGE-X MD
AUTHOR=VANTAGE-X MD
WM=VANTAGE-X MD

# ── FEATURES ──────────────────────────────────────────────────────────────────
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_RECORD_TYPE=false
AUTO_BIO=true
AUTO_SW_VIEW=false
AUTO_REACT=false
AUTO_LIKE_STATUS=false
WELCOME=true

# ── HOSTING / KEEPALIVE ───────────────────────────────────────────────────────
# Set KEEPALIVE=true on Render or any platform that idles after inactivity.
KEEPALIVE=false

# Required for keepalive on non-Render platforms.
# Render sets RENDER_EXTERNAL_URL automatically — leave this blank on Render.
PUBLIC_URL=

# ── EFFICIENCY / CONCURRENCY ──────────────────────────────────────────────────
# Max number of heavy commands that can run simultaneously.
MAX_CONCURRENT_HEAVY=3

# Set to true on low-RAM devices (Termux, cheap VPS)
# Disables: auto-read, auto-typing, recording, reactions, etc
LOW_POWER_MODE=false